# Copy this file to .env and fill in values for local/production use

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True

# Production database (set by Render automatically)
DATABASE_URL=

# CORS — comma-separated list of allowed frontend origins (production)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# ALLOWED_HOSTS — comma-separated (production)
ALLOWED_HOSTS=your-app.onrender.com

# Email (Gmail SMTP)
EMAIL_HOST_USER=patisaranya@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-gmail-app-password
